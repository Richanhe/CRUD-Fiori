<mvc:View controllerName="project1.controller.ODataCRUD"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{i18n>oDataCRUD}">
        <content>
            <HBox class="sapUiMediumMargin" gap="0.5rem">
                <VBox >
                    <Label text="{i18n>firstName}"></Label>
                    <Input type="Text" id="oDataCRUDFirstNameInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>lastName}"></Label>
                    <Input type="Text" id="oDataCRUDLastNameInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>age}"></Label>
                    <Input type="Number" id="oDataCRUDAgeInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>hobbies}"></Label>
                    <MultiInput 
                        id="oDataCRUDHobbiesInput"
                        submit=".onSubmitHobby"
                    ></MultiInput>
                </VBox>
                <VBox >
                    <Label ></Label>
                    <Button id="oDataCRUDSaveButton" press=".onPressAddUser" text="{i18n>addUser}"></Button>
                </VBox>
            </HBox>
            <HBox gap='0.5rem' alignItems="Center">
                <Title text="{i18n>users}"></Title>
                <Button text="{i18n>deletedUsers}" press=".onPressShowDeletedUsers"></Button>
            </HBox>
            <Table id="usersTable" items="{/Users}">
                <columns>
                    <Column>
                        <Text text="{i18n>name}"></Text>
                    </Column>
                    <Column>
                        <Text text="{i18n>age}"></Text>
                    </Column>
                    <!-- <Column >
                        <Text text="{i18n>hobbies}"></Text>
                    </Column> -->
                    <Column >
                        <Text text="{i18n>actions}"></Text>
                    </Column>
                </columns>
                <ColumnListItem id="userItemTemplate">
                    <cells>
                        <ObjectIdentifier title="{firstname} {lastname}" text="{user_id}"></ObjectIdentifier>
                        <Text text="{age}"></Text>
                        <!-- <List items="{path: 'Hobbies', templateShareable: false}">
                            <StandardListItem title="{name}"></StandardListItem>
                        </List> -->
                        <HBox gap="0.5rem">
                            <Button 
                                text="{i18n>update}"
                                press=".onPressEditUser"
                            ></Button>
                            <Button 
                                text="{i18n>delete}"
                                type="Reject"
                                press=".onPressDeleteUser"
                            ></Button>
                            <Button 
                                text="{i18n>restore}"
                                press=".onPressRestoreUser"
                            ></Button>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </Table>
        </content>
    </Page>
</mvc:View>