<mvc:View controllerName="project1.controller.ODataCRUD"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page>
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="{i18n>oDataCRUD}"/>
                </contentLeft>
            </Bar>
        </customHeader>
        <content>
            <HBox class="sapUiSmallMargin" gap="0.5rem">
                <VBox >
                    <Label text="{i18n>firstName}"></Label>
                    <Input type="Text" id="oDataCRUDFirstNameInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>lastName}"></Label>
                    <Input type="Text" id="oDataCRUDLastNameInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>age}"></Label>
                    <Input type="Number" id="oDataCRUDAgeInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>hobbies}"></Label>
                    <MultiInput 
                        id="oDataCRUDHobbiesInput"
                        submit=".onSubmitHobby"
                        showSuggestion="true"
                        liveChange=".onHobbyLiveChange"
                        tokenUpdate=".onTokenUpdate"
                    ></MultiInput>
                </VBox>
                <VBox >
                    <Label ></Label>
                    <Button id="oDataCRUDSaveButton" press=".onPressAddUser" text="{i18n>add}"></Button>
                </VBox>
                <VBox >
                    <Label ></Label>
                    <Button visible='false' id="cancelUpdateButton" type="Reject" press=".onPressCancelUpdate" text="{i18n>cancel}"></Button>
                </VBox>
            </HBox>
            <HBox gap='0.5rem' alignItems="Center">
                <Title text="{i18n>users}" class="sapUiSmallMarginBegin"></Title>
                <Button text="{i18n>deletedUsers}" press=".onPressShowDeletedUsers"></Button>
            </HBox>
            <Table id="usersTable" items="{/Users}">
                <columns>
                    <Column>
                        <Text text="{i18n>name}"></Text>
                    </Column>
                    <Column>
                        <Text text="{i18n>age}"></Text>
                    </Column>
                    <Column >
                        <Text text="{i18n>hobbies}"></Text>
                    </Column>
                    <Column >
                        <Text text="{i18n>actions}"></Text>
                    </Column>
                </columns>
                <ColumnListItem id="userItemTemplate">
                    <cells>
                        <ObjectIdentifier title="{firstname} {lastname}" text="{user_id}"></ObjectIdentifier>
                        <Text text="{age}"></Text>
                        <List items="{path: '_Hobbies', templateShareable: false}">
                            <StandardListItem title="{_Hobby/name}"></StandardListItem>
                        </List>
                        <HBox gap="0.5rem">
                            <Button 
                                text="{i18n>update}"
                                press=".onPressEditUser"
                                id="editButton"
                            ></Button>
                            <Button 
                                text="{i18n>delete}"
                                type="Reject"
                                press=".onPressDeleteUser"
                                id="deleteButton"
                            ></Button>
                            <Button 
                                text="{i18n>restore}"
                                press=".onPressRestoreUser"
                                visible='false'
                                id="restoreButton"
                            ></Button>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </Table>
        </content>
    </Page>
</mvc:View>