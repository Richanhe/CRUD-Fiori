<mvc:View controllerName="project1.controller.FactoryFunctions"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{i18n>factoryFunctions}">
        <content>
            <Table items="{path:'/Products', factory:'.productFactory'}">
                <columns>
                    <Column >
                        <Text text="{i18n>product}"></Text>
                    </Column>
                    <Column >
                        <Text text="{i18n>perUnit}"></Text>
                    </Column>
                    <Column >
                        <Text text="{i18n>inStock}"></Text>
                    </Column>
                </columns>
            </Table>
        </content>
    </Page>
</mvc:View>