<mvc:View controllerName="project1.controller.FullName"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{i18n>noDataBinding}">
        <content>
            <HBox 
                class="sapUiMediumMargin"
                gap="0.5rem"
            >
                <VBox >
                    <Label text="{i18n>firstName}"></Label>
                    <Input
                        id="firstNameInput"
                        change=".processFullName"
                    ></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>lastName}"></Label>
                    <Input
                        id="lastNameInput"
                        change=".processFullName"
                    ></Input>
                </VBox>
            </HBox>
            <VBox class="sapUiMediumMargin">
                <Label text="{i18n>fullName}"></Label>
                <Input editable="false" enabled="false" id="fullNameInput"></Input>
            </VBox>
        </content>
    </Page>
</mvc:View>