<mvc:View controllerName="project1.controller.CRUD"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{i18n>CRUD}">
        <content>
            <HBox class="sapUiMediumMargin" gap="0.5rem">
                <VBox >
                    <Label text="{i18n>firstName}"></Label>
                    <Input type="Text" id="CRUDFirstNameInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>lastName}"></Label>
                    <Input type="Text" id="CRUDLastNameInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>age}"></Label>
                    <Input type="Number" id="ageInput"></Input>
                </VBox>
                <VBox >
                    <Label text="{i18n>hobbies}"></Label>
                    <MultiInput 
                        id="hobbiesInput"
                        submit=".onSubmitHobby"
                    ></MultiInput>
                </VBox>
                <VBox >
                    <Label ></Label>
                    <Button id="saveButton" press=".onPressAddUser" text="{i18n>add}"></Button>
                </VBox>
            </HBox>

            <Title class="sapUiMediumMargin" text="{i18n>users}"></Title>
            <Table items="{/Users}">
                <columns>
                    <Column>
                        <Text text="{i18n>name}"></Text>
                    </Column>
                    <Column>
                        <Text text="{i18n>age}"></Text>
                    </Column>
                    <Column >
                        <Text text="{i18n>hobbies}"></Text>
                    </Column>
                    <Column >
                        <Text text="{i18n>actions}"></Text>
                    </Column>
                </columns>
                <ColumnListItem>
                    <cells>
                        <ObjectIdentifier title="{FirstName} {LastName}" text="{UserID}"></ObjectIdentifier>
                        <Text text="{Age}"></Text>
                        <List items="{path: 'Hobbies', templateShareable: false}">
                            <StandardListItem title="{name}"></StandardListItem>
                        </List>
                        <HBox gap="0.5rem">
                            <Button 
                                text="{i18n>update}"
                                press=".onPressEditUser"
                            ></Button>
                            <Button 
                                text="{i18n>delete}"
                                type="Reject"
                                press=".onPressDeleteUser"
                            ></Button>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </Table>
        </content>
    </Page>
</mvc:View>