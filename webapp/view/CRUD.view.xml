<mvc:View controllerName="project1.controller.CRUD"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{i18n>CRUDPageName}">
        <content>
            <HBox class="sapUiMediumMargin" gap="0.5rem">
                <VBox >
                    <Label text="Primeiro nome"></Label>
                    <Input type="Text" id="CRUDFirstNameInput"></Input>
                </VBox>
                <VBox >
                    <Label text="Último nome"></Label>
                    <Input type="Text" id="CRUDLastNameInput"></Input>
                </VBox>
                <VBox >
                    <Label text="Idade"></Label>
                    <Input type="Number" id="ageInput"></Input>
                </VBox>
                <VBox >
                    <Label text="Hobbies"></Label>
                    <MultiInput 
                        id="hobbiesInput"
                        submit=".onSubmitHobby"
                    ></MultiInput>
                </VBox>
                <VBox >
                    <Label ></Label>
                    <Button id="saveButton" press=".onPressAddUser" text="Adicionar usuário"></Button>
                </VBox>
            </HBox>

            <Title class="sapUiMediumMargin" text="Usuários"></Title>
            <Table items="{/Users}">
                <columns>
                    <Column>
                        <Text text="Nome"></Text>
                    </Column>
                    <Column>
                        <Text text="Idade"></Text>
                    </Column>
                    <Column >
                        <Text text="Hobbies"></Text>
                    </Column>
                    <Column >
                        <Text text="Ações"></Text>
                    </Column>
                </columns>
                <ColumnListItem>
                    <cells>
                        <ObjectIdentifier title="{FirstName} {LastName}" text="{UserID}"></ObjectIdentifier>
                        <Text text="{Age}"></Text>
                        <List items="{path: 'Hobbies', templateShareable: false}">
                            <StandardListItem title="{name}"></StandardListItem>
                        </List>
                        <HBox gap="0.5rem">
                            <Button 
                                text="Editar"
                                press=".onPressEditUser"
                            ></Button>
                            <Button 
                                text="Excluir"
                                type="Reject"
                                press=".onPressDeleteUser"
                            ></Button>
                        </HBox>
                    </cells>
                </ColumnListItem>
            </Table>
        </content>
    </Page>
</mvc:View>